# Example Remote State Backend Configuration
# Rename to backend.tf and replace bucket / region / table with your cloud values.

terraform {
  backend "s3" {
    bucket         = "YOUR-F5-TFSTATE-BUCKET"
    key            = "prod/tenants/pair-b/ltm/onboarding/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "f5-terraform-state-locks"
  }
}
